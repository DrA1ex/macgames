--- /dev/null
+++ b/tests/test_log_pressure.cpp
@@ -0,0 +1,63 @@
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include "rosetta_core/IRBlock.h"
+#include "rosetta_core/Config.h"
+#include "rosetta_core/CoreConfig.h"
+#include "rosetta_core/Opcode.h"
+#include "rosetta_core/Register.h"
+#include "rosetta_core/TranslationResult.h"
+#include "rosetta_core/TranscendentalHelper.h"
+#include "rosetta_core/Translator.h"
+#include "rosetta_core/TranslatorX87.h"
+
+static void check(uint32_t mask, bool plus_one, bool mid_run=false) {
+    ThreadContextOffsets offsets{};
+    TranslationResult tr{};
+    tr.insn_buf.data = static_cast<uint32_t*>(std::calloc(1, 65536));
+    tr.insn_buf.end_cap = 65536;
+    tr.insn_buf.use_heap = 1;
+    tr.thread_context_offsets = &offsets;
+    tr.free_gpr_mask = kGprScratchMask;
+    tr.free_fpr_mask = mask;
+    tr._unoccupied_temporary_fprs_for_xmm_scalars = mask;
+    if (__builtin_popcount(mask) >= 7) {
+        if (plus_one) TranslatorX87::translate_fyl2xp1(&tr, nullptr);
+        else TranslatorX87::translate_fyl2x(&tr, nullptr);
+        assert(tr.insn_buf.end > 0);
+    } else {
+        IRInstr instrs[2]{};
+        instrs[0].set_opcode(mid_run ? kOpcodeName_fld1 : (plus_one ? kOpcodeName_fyl2xp1 : kOpcodeName_fyl2x));
+        instrs[1].set_opcode(plus_one ? kOpcodeName_fyl2xp1 : kOpcodeName_fyl2x);
+        IRBlock block{};
+        block.instrs = instrs;
+        block.num_instrs = mid_run ? 2 : 1;
+        auto next=Translator::translate_instruction(&tr, &block, instrs, block.num_instrs, 0);
+        if (mid_run) {
+            assert(next && *next==1);
+            assert(tr.insn_buf.end>0);
+        } else {
+            assert(!next);
+            assert(tr.insn_buf.end==0);
+        }
+        assert(!tr.x87_cache.active());
+    }
+    assert(tr.free_fpr_mask == mask);
+    assert(tr.free_gpr_mask == kGprScratchMask);
+    std::printf("PASS %s mask=%08x free=%d emitted=%llu\n", plus_one ? "FYL2XP1" : "FYL2X",
+                mask, __builtin_popcount(mask), static_cast<unsigned long long>(tr.insn_buf.end));
+    std::free(tr.insn_buf.data);
+}
+int main() {
+    RosettaConfig config{};
+    config.disable_x87_ir=1;
+    config.disabled_fusions_mask=~uint64_t{0};
+    rosetta_set_config(&config);
+    rosetta_core::set_transcendental_constants_addr(0x123456780);
+    for (bool plus_one : {false, true}) {
+        check(kFprScratchMask, plus_one);
+        for (int r=24; r<32; ++r) check(kFprScratchMask & ~(1U<<r), plus_one);
+        for (int n=0; n<7; ++n) check(((1U<<n)-1U)<<24, plus_one);
+        check(0x3f000000, plus_one, true);
+    }
+}
