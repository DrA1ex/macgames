--- /dev/null
+++ b/tests/test_fsincos_pressure.cpp
@@ -0,0 +1,34 @@
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include "rosetta_core/Register.h"
+#include "rosetta_core/TranslationResult.h"
+#include "rosetta_core/TranscendentalHelper.h"
+#include "rosetta_core/TranslatorX87.h"
+
+static void check(uint32_t mask) {
+    ThreadContextOffsets offsets{};
+    TranslationResult tr{};
+    tr.insn_buf.data = static_cast<uint32_t*>(std::calloc(1, 65536));
+    tr.insn_buf.end_cap = 65536;
+    tr.insn_buf.use_heap = 1;
+    tr.thread_context_offsets = &offsets;
+    tr.free_gpr_mask = kGprScratchMask;
+    tr.free_fpr_mask = mask;
+    tr._unoccupied_temporary_fprs_for_xmm_scalars = mask;
+    rosetta_core::set_transcendental_constants_addr(0x123456780);
+    TranslatorX87::translate_fsincos(&tr, nullptr);
+    assert(tr.free_fpr_mask == mask);
+    assert(tr.free_gpr_mask == kGprScratchMask);
+    std::printf("PASS FSINCOS with %d free FPRs: %llu bytes, masks restored\n",
+                __builtin_popcount(mask), static_cast<unsigned long long>(tr.insn_buf.end));
+    std::free(tr.insn_buf.data);
+}
+
+int main() {
+    check(kFprScratchMask);
+    // Each possible missing scratch register, not just a contiguous mask.
+    for (int r = 24; r != 32; ++r) {
+        check(kFprScratchMask & ~(1U << r));
+    }
+}
