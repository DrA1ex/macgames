+/* CS/DS are process-wide constants in the Unix signal implementation. The
+ * debug-register and FS caches are thread-local and must always be read live.
+ * Keep the first Unix call to obtain selectors rather than assuming their
+ * platform-specific values. Later faults avoid a full Unix-call transition.
+ */
+static NTSTATUS aoe_fill_exception_context( CONTEXT *context )
+{
+    static LONG cached_selectors;
+    ULONG selectors = __atomic_load_n( &cached_selectors, __ATOMIC_ACQUIRE );
+    const volatile BYTE *teb;
+    NTSTATUS status;
+
+    C_ASSERT( offsetof( TEB, GdiTebBatch ) == AOE_TEB_DR0 );
+    if (!selectors)
+    {
+        if ((status = WINE_UNIX_CALL( unix_aoe_exception_context, context ))) return status;
+        selectors = context->SegCs | ((ULONG)context->SegSs << 16);
+        __atomic_store_n( &cached_selectors, selectors, __ATOMIC_RELEASE );
+        return STATUS_SUCCESS;
+    }
+    teb = (const volatile BYTE *)NtCurrentTeb();
+    context->SegCs = selectors;
+    context->SegSs = context->SegDs = context->SegEs = context->SegGs = selectors >> 16;
+    context->SegFs = *(const volatile DWORD *)(teb + AOE_TEB_FS);
+    context->Dr0 = *(const volatile ULONG64 *)(teb + AOE_TEB_DR0);
+    context->Dr1 = *(const volatile ULONG64 *)(teb + AOE_TEB_DR1);
+    context->Dr2 = *(const volatile ULONG64 *)(teb + AOE_TEB_DR2);
+    context->Dr3 = *(const volatile ULONG64 *)(teb + AOE_TEB_DR3);
+    context->Dr6 = *(const volatile ULONG64 *)(teb + AOE_TEB_DR6);
+    context->Dr7 = *(const volatile ULONG64 *)(teb + AOE_TEB_DR7);
+    return STATUS_SUCCESS;
+}
