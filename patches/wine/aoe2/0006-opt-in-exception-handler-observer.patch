@@ -58,6 +58,29 @@
 static RTL_CRITICAL_SECTION vectored_handlers_section = { &critsect_debug, -1, 0, 0, 0, 0 };
 
 static PRTL_EXCEPTION_FILTER unhandled_exception_filter;
+
+/* Diagnostic-only observer. No observer is installed by default. It sees
+ * the existing dispatch, never replaces a handler or changes its result.
+ * The registering module must remain loaded until process termination. */
+typedef ULONGLONG (WINAPI *aoe_exception_observer)(ULONG phase, ULONG_PTR pc,
+        EXCEPTION_RECORD *rec, CONTEXT *context, void *handler, LONG result, ULONGLONG token);
+static void *volatile aoe_observer;
+
+void *WINAPI __wine_aoe_set_exception_observer( void *observer )
+{
+    return InterlockedExchangePointer( &aoe_observer, observer );
+}
+
+static ULONGLONG aoe_notify( aoe_exception_observer observer, ULONG phase, ULONG_PTR pc,
+        EXCEPTION_RECORD *rec, CONTEXT *context, void *handler, LONG result, ULONGLONG token )
+{
+    ULONG error = NtCurrentTeb()->LastErrorValue;
+    NTSTATUS status = NtCurrentTeb()->LastStatusValue;
+    ULONGLONG ret = observer( phase, pc, rec, context, handler, result, token );
+    NtCurrentTeb()->LastErrorValue = error;
+    NtCurrentTeb()->LastStatusValue = status;
+    return ret;
+}
 
